# ==============================================================================
# 000-MISSION-CONTROL: ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env and configure before starting containers: cp .env.example .env
# ==============================================================================

# Public domain name for Caddy automatic Let's Encrypt SSL certificate
# Examples: 000.yourdomain.com | mission.company.dev | 000.localhost
DOMAIN_NAME=000.localhost

# Contact email required by Let's Encrypt for certificate expiration notices
ADMIN_EMAIL=admin@000.localhost

# Standalone port mapping (only used when running docker-compose.standalone.yml)
PORT=3000
